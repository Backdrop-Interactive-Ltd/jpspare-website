generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum RoleName {
  SUPER_ADMIN
  ADMIN
  PRODUCT_MANAGER
  CONTENT_EDITOR
  ORDER_MANAGER
  SUPPORT_STAFF
}

enum SyncStatus {
  LOCAL
  PENDING
  SYNCED
  FAILED
}

enum ApiKeyStatus {
  ACTIVE
  INACTIVE
  REVOKED
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum MediaType {
  IMAGE
  VIDEO
  DOCUMENT
  OTHER
}

enum CustomerStatus {
  ACTIVE
  BLOCKED
}

enum OtpChannel {
  PHONE
  EMAIL
}

enum OtpProviderType {
  GENERIC_HTTP
  SMTP
  CUSTOM_API
}

enum OtpTemplatePurpose {
  OTP_LOGIN
}

enum AddressType {
  BILLING
  SHIPPING
  BOTH
}

enum CartStatus {
  ACTIVE
  CONVERTED
  ABANDONED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PENDING
  PAID
  FAILED
  REFUNDED
  CANCELLED
}

enum PaymentMethod {
  CASH_ON_DELIVERY
  SSLCOMMERZ
  BKASH
  NAGAD
  CARD
  STRIPE
  BANK_TRANSFER
}

enum StockStatus {
  IN_STOCK
  LOW_STOCK
  OUT_OF_STOCK
}

enum StockMovementType {
  STOCK_IN
  STOCK_OUT
  ORDER_RESERVED
  ORDER_CONFIRMED
  ORDER_CANCELLED
  MANUAL_ADJUSTMENT
  RETURN_ADJUSTMENT
}

enum SupplierStatus {
  ACTIVE
  INACTIVE
}

enum PurchaseStatus {
  DRAFT
  ORDERED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum PurchaseTimelineType {
  CREATED
  ORDERED
  RECEIVED
  CANCELLED
  NOTE
  STATUS_CHANGED
}

model User {
  id                     String                  @id @default(cuid())
  email                  String                  @unique
  passwordHash           String
  name                   String?
  isActive               Boolean                 @default(true)
  lastLoginAt            DateTime?
  roles                  RoleAssignment[]
  mediaUploads           Media[]
  apiKeys                ApiKey[]
  stockMoves             InventoryMovement[]
  purchaseCreatedBy      PurchaseOrder[]         @relation("PurchaseCreatedBy")
  purchaseUpdatedBy      PurchaseOrder[]         @relation("PurchaseUpdatedBy")
  purchaseTimelineEvents PurchaseTimelineEvent[]
  externalId             String?
  source                 String                  @default("LOCAL")
  syncStatus             SyncStatus              @default(LOCAL)
  lastSyncedAt           DateTime?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt

  @@index([externalId])
  @@index([source, syncStatus])
}

model ApiKey {
  id           String       @id @default(cuid())
  name         String       @default("BMS Integration")
  keyPrefix    String
  keyHash      String       @unique
  status       ApiKeyStatus @default(ACTIVE)
  allowedIps   String?
  webhookUrl   String?
  lastUsedAt   DateTime?
  revokedAt    DateTime?
  createdById  String?
  createdBy    User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)
  source       String       @default("LOCAL")
  syncStatus   SyncStatus   @default(LOCAL)
  lastSyncedAt DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([status])
  @@index([keyPrefix])
  @@index([createdById])
  @@index([source, syncStatus])
}

model Role {
  id          String           @id @default(cuid())
  name        RoleName         @unique
  description String?
  users       RoleAssignment[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model RoleAssignment {
  userId     String
  roleId     String
  assignedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model Category {
  id             String          @id @default(cuid())
  name           String
  slug           String          @unique
  description    String?
  thumbnailUrl   String?
  iconUrl        String?
  parentId       String?
  parent         Category?       @relation("CategoryTree", fields: [parentId], references: [id])
  children       Category[]      @relation("CategoryTree")
  products       Product[]
  images         CategoryImage[]
  sortOrder      Int             @default(0)
  isActive       Boolean         @default(true)
  isFeatured     Boolean         @default(false)
  showInMenu     Boolean         @default(true)
  seoTitle       String?
  seoDescription String?
  seoKeywords    String?
  externalId     String?
  source         String          @default("LOCAL")
  syncStatus     SyncStatus      @default(LOCAL)
  lastSyncedAt   DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([parentId])
  @@index([isFeatured])
  @@index([showInMenu])
  @@index([externalId])
  @@index([source, syncStatus])
}

model Brand {
  id             String     @id @default(cuid())
  name           String
  slug           String     @unique
  description    String?
  logoUrl        String?
  coverImageUrl  String?
  websiteUrl     String?
  products       Product[]
  isActive       Boolean    @default(true)
  isFeatured     Boolean    @default(false)
  seoTitle       String?
  seoDescription String?
  seoKeywords    String?
  externalId     String?
  source         String     @default("LOCAL")
  syncStatus     SyncStatus @default(LOCAL)
  lastSyncedAt   DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([isFeatured])
  @@index([externalId])
  @@index([source, syncStatus])
}

model Product {
  id                 String                 @id @default(cuid())
  title              String
  slug               String                 @unique
  sku                String?                @unique
  barcode            String?
  shortDescription   String?
  fullDescription    String?
  description        String?
  price              Decimal                @db.Decimal(12, 2)
  discountPrice      Decimal?               @db.Decimal(12, 2)
  costPrice          Decimal?               @db.Decimal(12, 2)
  compareAtPrice     Decimal?               @db.Decimal(12, 2)
  status             ProductStatus          @default(DRAFT)
  stockQuantity      Int                    @default(0)
  reservedStock      Int                    @default(0)
  lowStockThreshold  Int                    @default(5)
  stockStatus        StockStatus            @default(IN_STOCK)
  warehouseId        String?
  externalStockId    String?
  isFeatured         Boolean                @default(false)
  seoTitle           String?
  seoDescription     String?
  seoKeywords        String?
  categoryId         String?
  brandId            String?
  category           Category?              @relation(fields: [categoryId], references: [id])
  brand              Brand?                 @relation(fields: [brandId], references: [id])
  media              ProductMedia[]
  images             ProductImage[]
  tags               ProductTag[]
  specifications     ProductSpecification[]
  cartItems          CartItem[]
  wishlistItems      WishlistItem[]
  orderItems         OrderItem[]
  inventoryMovements InventoryMovement[]
  purchaseItems      PurchaseOrderItem[]
  externalId         String?
  source             String                 @default("LOCAL")
  syncStatus         SyncStatus             @default(LOCAL)
  lastSyncedAt       DateTime?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  @@index([categoryId])
  @@index([brandId])
  @@index([status])
  @@index([stockStatus])
  @@index([warehouseId])
  @@index([externalStockId])
  @@index([isFeatured])
  @@index([externalId])
  @@index([source, syncStatus])
}

model InventoryMovement {
  id                    String            @id @default(cuid())
  productId             String
  product               Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  type                  StockMovementType
  quantity              Int
  previousStock         Int
  newStock              Int
  previousReservedStock Int               @default(0)
  newReservedStock      Int               @default(0)
  reason                String?
  orderId               String?
  order                 Order?            @relation(fields: [orderId], references: [id], onDelete: SetNull)
  purchaseOrderId       String?
  purchaseOrder         PurchaseOrder?    @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  adminUserId           String?
  adminUser             User?             @relation(fields: [adminUserId], references: [id], onDelete: SetNull)
  warehouseId           String?
  externalStockId       String?
  source                String            @default("LOCAL")
  syncStatus            SyncStatus        @default(LOCAL)
  lastSyncedAt          DateTime?
  createdAt             DateTime          @default(now())

  @@index([productId])
  @@index([type])
  @@index([orderId])
  @@index([purchaseOrderId])
  @@index([adminUserId])
  @@index([warehouseId])
  @@index([externalStockId])
  @@index([source, syncStatus])
  @@index([createdAt])
}

model ProductImage {
  id           String     @id @default(cuid())
  productId    String
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  mediaId      String?
  media        Media?     @relation(fields: [mediaId], references: [id], onDelete: SetNull)
  url          String
  alt          String?
  sortOrder    Int        @default(0)
  isThumbnail  Boolean    @default(false)
  externalId   String?
  source       String     @default("LOCAL")
  syncStatus   SyncStatus @default(LOCAL)
  lastSyncedAt DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([productId])
  @@index([mediaId])
  @@index([externalId])
  @@index([source, syncStatus])
}

model CategoryImage {
  id           String     @id @default(cuid())
  categoryId   String
  category     Category   @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  mediaId      String?
  media        Media?     @relation(fields: [mediaId], references: [id], onDelete: SetNull)
  url          String
  type         String     @default("THUMBNAIL")
  alt          String?
  sortOrder    Int        @default(0)
  externalId   String?
  source       String     @default("LOCAL")
  syncStatus   SyncStatus @default(LOCAL)
  lastSyncedAt DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([categoryId])
  @@index([mediaId])
  @@index([externalId])
  @@index([source, syncStatus])
}

model ProductTag {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime @default(now())

  @@unique([productId, name])
  @@index([productId])
}

model ProductSpecification {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String
  value     String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
}

model Media {
  id             String          @id @default(cuid())
  url            String
  type           MediaType       @default(IMAGE)
  alt            String?
  fileName       String?
  filename       String?
  originalName   String?
  filePath       String?
  mimeType       String?
  fileSize       Int?
  size           Int?
  width          Int?
  height         Int?
  uploadedById   String?
  uploadedBy     User?           @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  products       ProductMedia[]
  productImages  ProductImage[]
  categoryImages CategoryImage[]
  externalId     String?
  source         String          @default("LOCAL")
  syncStatus     SyncStatus      @default(LOCAL)
  lastSyncedAt   DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([uploadedById])
  @@index([mimeType])
  @@index([externalId])
  @@index([source, syncStatus])
}

model ProductMedia {
  productId String
  mediaId   String
  sortOrder Int     @default(0)
  alt       String?
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  media     Media   @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@id([productId, mediaId])
}

model SiteSetting {
  id           String     @id @default(cuid())
  key          String     @unique
  value        Json
  group        String     @default("general")
  isPublic     Boolean    @default(false)
  externalId   String?
  source       String     @default("LOCAL")
  syncStatus   SyncStatus @default(LOCAL)
  lastSyncedAt DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([group])
  @@index([externalId])
  @@index([source, syncStatus])
}

model HomeSection {
  id           String     @id @default(cuid())
  key          String     @unique
  title        String
  type         String
  content      Json
  sortOrder    Int        @default(0)
  isActive     Boolean    @default(true)
  externalId   String?
  source       String     @default("LOCAL")
  syncStatus   SyncStatus @default(LOCAL)
  lastSyncedAt DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([type])
  @@index([externalId])
  @@index([source, syncStatus])
}

model Customer {
  id           String            @id @default(cuid())
  email        String?           @unique
  passwordHash String?
  firstName    String?
  lastName     String?
  phone        String?           @unique
  status       CustomerStatus    @default(ACTIVE)
  lastLoginAt  DateTime?
  addresses    CustomerAddress[]
  vehicles     CustomerVehicle[]
  carts        Cart[]
  wishlist     WishlistItem[]
  orders       Order[]
  externalId   String?
  source       String            @default("LOCAL")
  syncStatus   SyncStatus        @default(LOCAL)
  lastSyncedAt DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([status])
  @@index([externalId])
  @@index([source, syncStatus])
}

model CustomerOtp {
  id          String     @id @default(cuid())
  identifier  String
  channel     OtpChannel
  otpHash     String
  expiresAt   DateTime
  attempts    Int        @default(0)
  maxAttempts Int        @default(5)
  usedAt      DateTime?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([identifier, channel])
  @@index([expiresAt])
  @@index([usedAt])
  @@index([createdAt])
}

model OtpProvider {
  id                  String          @id @default(cuid())
  name                String
  channel             OtpChannel
  providerType        OtpProviderType
  isActive            Boolean         @default(true)
  isDefault           Boolean         @default(false)
  baseUrl             String?
  method              String?
  fromEmail           String?
  fromName            String?
  senderId            String?
  configJson          Json?
  secretJsonEncrypted String?
  timeoutMs           Int             @default(10000)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  @@index([channel])
  @@index([channel, isActive])
  @@index([channel, isDefault])
  @@index([providerType])
}

model OtpTemplate {
  id        String             @id @default(cuid())
  channel   OtpChannel
  purpose   OtpTemplatePurpose @default(OTP_LOGIN)
  subject   String?
  message   String
  isActive  Boolean            @default(true)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@index([channel])
  @@index([channel, purpose])
  @@index([isActive])
}

model CustomerAddress {
  id           String      @id @default(cuid())
  customerId   String
  customer     Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  type         AddressType @default(SHIPPING)
  firstName    String?
  lastName     String?
  phone        String?
  addressLine1 String
  addressLine2 String?
  city         String?
  zone         String?
  postalCode   String?
  country      String      @default("Bangladesh")
  isDefault    Boolean     @default(false)
  externalId   String?
  source       String      @default("LOCAL")
  syncStatus   SyncStatus  @default(LOCAL)
  lastSyncedAt DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([customerId])
  @@index([externalId])
  @@index([source, syncStatus])
}

model CustomerVehicle {
  id           String     @id @default(cuid())
  customerId   String
  customer     Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  make         String
  model        String
  year         Int?
  chassisCode  String?
  engineType   String?
  isDefault    Boolean    @default(false)
  externalId   String?
  source       String     @default("LOCAL")
  syncStatus   SyncStatus @default(LOCAL)
  lastSyncedAt DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([customerId])
  @@index([make, model])
  @@index([externalId])
  @@index([source, syncStatus])
}

model Cart {
  id           String     @id @default(cuid())
  customerId   String?
  customer     Customer?  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  guestId      String?
  status       CartStatus @default(ACTIVE)
  currency     String     @default("BDT")
  subtotal     Decimal    @default(0) @db.Decimal(12, 2)
  items        CartItem[]
  order        Order?
  externalId   String?
  source       String     @default("LOCAL")
  syncStatus   SyncStatus @default(LOCAL)
  lastSyncedAt DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([customerId, status])
  @@index([guestId, status])
  @@index([externalId])
  @@index([source, syncStatus])
}

model CartItem {
  id           String     @id @default(cuid())
  cartId       String
  cart         Cart       @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId    String?
  product      Product?   @relation(fields: [productId], references: [id], onDelete: SetNull)
  productTitle String
  sku          String?
  imageUrl     String?
  unitPrice    Decimal    @db.Decimal(12, 2)
  quantity     Int        @default(1)
  externalId   String?
  source       String     @default("LOCAL")
  syncStatus   SyncStatus @default(LOCAL)
  lastSyncedAt DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([cartId])
  @@index([productId])
  @@index([externalId])
  @@index([source, syncStatus])
}

model WishlistItem {
  id           String     @id @default(cuid())
  customerId   String?
  customer     Customer?  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  guestId      String?
  productId    String?
  product      Product?   @relation(fields: [productId], references: [id], onDelete: SetNull)
  productTitle String
  sku          String?
  imageUrl     String?
  unitPrice    Decimal?   @db.Decimal(12, 2)
  productUrl   String?
  externalId   String?
  source       String     @default("LOCAL")
  syncStatus   SyncStatus @default(LOCAL)
  lastSyncedAt DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([customerId])
  @@index([guestId])
  @@index([productId])
  @@index([externalId])
  @@index([source, syncStatus])
}

model Coupon {
  id            String     @id @default(cuid())
  code          String     @unique
  description   String?
  discountType  String     @default("FIXED")
  discountValue Decimal    @db.Decimal(12, 2)
  minOrderValue Decimal?   @db.Decimal(12, 2)
  maxDiscount   Decimal?   @db.Decimal(12, 2)
  startsAt      DateTime?
  endsAt        DateTime?
  usageLimit    Int?
  usedCount     Int        @default(0)
  isActive      Boolean    @default(true)
  orders        Order[]
  externalId    String?
  source        String     @default("LOCAL")
  syncStatus    SyncStatus @default(LOCAL)
  lastSyncedAt  DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([isActive])
  @@index([externalId])
  @@index([source, syncStatus])
}

model Order {
  id                 String              @id @default(cuid())
  orderNumber        String              @unique
  customerId         String?
  customer           Customer?           @relation(fields: [customerId], references: [id], onDelete: SetNull)
  cartId             String?             @unique
  cart               Cart?               @relation(fields: [cartId], references: [id], onDelete: SetNull)
  couponId           String?
  coupon             Coupon?             @relation(fields: [couponId], references: [id], onDelete: SetNull)
  items              OrderItem[]
  payments           Payment[]
  inventoryMovements InventoryMovement[]
  status             OrderStatus         @default(PENDING)
  paymentStatus      PaymentStatus       @default(UNPAID)
  paymentMethod      PaymentMethod       @default(CASH_ON_DELIVERY)
  paymentGateway     String?
  transactionId      String?
  paidAt             DateTime?
  gatewayResponse    Json?
  paymentMeta        Json?
  currency           String              @default("BDT")
  subtotal           Decimal             @db.Decimal(12, 2)
  discountTotal      Decimal             @default(0) @db.Decimal(12, 2)
  deliveryCharge     Decimal             @default(0) @db.Decimal(12, 2)
  taxTotal           Decimal             @default(0) @db.Decimal(12, 2)
  total              Decimal             @db.Decimal(12, 2)
  customerEmail      String?
  customerName       String?
  customerPhone      String?
  notes              String?
  billingAddress     Json?
  shippingAddress    Json?
  timeline           Json?
  invoiceNumber      String?             @unique
  invoiceGeneratedAt DateTime?
  printedAt          DateTime?
  externalOrderId    String?
  externalId         String?
  source             String              @default("LOCAL")
  syncStatus         SyncStatus          @default(LOCAL)
  lastSyncedAt       DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([customerId])
  @@index([status])
  @@index([paymentStatus])
  @@index([paymentGateway])
  @@index([transactionId])
  @@index([invoiceNumber])
  @@index([externalOrderId])
  @@index([externalId])
  @@index([source, syncStatus])
}

model OrderItem {
  id           String   @id @default(cuid())
  orderId      String
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    String?
  product      Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productTitle String
  sku          String?
  imageUrl     String?
  unitPrice    Decimal  @db.Decimal(12, 2)
  quantity     Int
  total        Decimal  @db.Decimal(12, 2)
  createdAt    DateTime @default(now())

  @@index([orderId])
  @@index([productId])
}

model Payment {
  id              String        @id @default(cuid())
  orderId         String
  order           Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  method          PaymentMethod
  status          PaymentStatus @default(PENDING)
  amount          Decimal       @db.Decimal(12, 2)
  transactionId   String?
  gateway         String?
  gatewayPayload  Json?
  gatewayResponse Json?
  paymentMeta     Json?
  paidAt          DateTime?
  externalId      String?
  source          String        @default("LOCAL")
  syncStatus      SyncStatus    @default(LOCAL)
  lastSyncedAt    DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([orderId])
  @@index([method, status])
  @@index([gateway])
  @@index([transactionId])
  @@index([externalId])
  @@index([source, syncStatus])
}

model Supplier {
  id            String          @id @default(cuid())
  name          String
  companyName   String?
  contactPerson String?
  phone         String?
  email         String?
  address       String?
  notes         String?
  status        SupplierStatus  @default(ACTIVE)
  purchases     PurchaseOrder[]
  externalId    String?
  source        String          @default("LOCAL")
  syncStatus    SyncStatus      @default(LOCAL)
  lastSyncedAt  DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([status])
  @@index([email])
  @@index([phone])
  @@index([externalId])
  @@index([source, syncStatus])
}

model PurchaseOrder {
  id                 String                  @id @default(cuid())
  purchaseNumber     String                  @unique
  supplierId         String?
  supplier           Supplier?               @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  status             PurchaseStatus          @default(DRAFT)
  subtotal           Decimal                 @default(0) @db.Decimal(12, 2)
  total              Decimal                 @default(0) @db.Decimal(12, 2)
  notes              String?
  warehouseId        String?
  externalPurchaseId String?
  externalId         String?
  source             String                  @default("LOCAL")
  syncStatus         SyncStatus              @default(LOCAL)
  lastSyncedAt       DateTime?
  orderedAt          DateTime?
  receivedAt         DateTime?
  cancelledAt        DateTime?
  createdById        String?
  createdBy          User?                   @relation("PurchaseCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById        String?
  updatedBy          User?                   @relation("PurchaseUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  items              PurchaseOrderItem[]
  timeline           PurchaseTimelineEvent[]
  inventoryMovements InventoryMovement[]
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  @@index([supplierId])
  @@index([status])
  @@index([warehouseId])
  @@index([externalPurchaseId])
  @@index([externalId])
  @@index([source, syncStatus])
  @@index([createdAt])
}

model PurchaseOrderItem {
  id               String        @id @default(cuid())
  purchaseOrderId  String
  purchaseOrder    PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  productId        String?
  product          Product?      @relation(fields: [productId], references: [id], onDelete: SetNull)
  productTitle     String
  sku              String?
  quantity         Int
  receivedQuantity Int           @default(0)
  costPrice        Decimal       @db.Decimal(12, 2)
  total            Decimal       @db.Decimal(12, 2)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([purchaseOrderId])
  @@index([productId])
}

model PurchaseTimelineEvent {
  id              String               @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder        @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  type            PurchaseTimelineType
  title           String
  message         String?
  fromStatus      PurchaseStatus?
  toStatus        PurchaseStatus?
  adminUserId     String?
  adminUser       User?                @relation(fields: [adminUserId], references: [id], onDelete: SetNull)
  createdAt       DateTime             @default(now())

  @@index([purchaseOrderId])
  @@index([type])
  @@index([adminUserId])
  @@index([createdAt])
}
