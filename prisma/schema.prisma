generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum RoleName {
  SUPER_ADMIN
  ADMIN
  PRODUCT_MANAGER
  CONTENT_EDITOR
  ORDER_MANAGER
  SUPPORT_STAFF
}

enum SyncStatus {
  LOCAL
  PENDING
  SYNCED
  FAILED
}

enum ApiKeyStatus {
  ACTIVE
  INACTIVE
  REVOKED
}

enum IntegrationEventStatus {
  RECEIVED
  PROCESSING
  SUCCESS
  FAILED
  SKIPPED
}

enum IntegrationConflictStatus {
  OPEN
  RESOLVED
  IGNORED
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum BlogPostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum MediaType {
  IMAGE
  VIDEO
  DOCUMENT
  OTHER
}

enum CustomerStatus {
  ACTIVE
  BLOCKED
}

enum OtpChannel {
  PHONE
  EMAIL
}

enum OtpProviderType {
  GENERIC_HTTP
  SMTP
  CUSTOM_API
}

enum OtpTemplatePurpose {
  OTP_LOGIN
}

enum EmailTemplateCategory {
  TRANSACTIONAL
  MARKETING
  AUTH
  ORDER
  SHIPPING
  SUPPORT
  NEWSLETTER
}

enum EmailDeliveryStatus {
  PENDING
  SENT
  FAILED
}

enum NotificationChannel {
  EMAIL
  SMS
  IN_APP
  PUSH
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  READ
}

enum AddressType {
  BILLING
  SHIPPING
  BOTH
}

enum CartStatus {
  ACTIVE
  CONVERTED
  ABANDONED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PENDING
  PAID
  FAILED
  REFUNDED
  CANCELLED
}

enum PaymentMethod {
  CASH_ON_DELIVERY
  SSLCOMMERZ
  BKASH
  NAGAD
  CARD
  STRIPE
  BANK_TRANSFER
}

enum CouponRedemptionStatus {
  APPLIED
  REDEEMED
  CANCELLED
  REFUNDED
}

enum LoyaltyTransactionType {
  EARN_ORDER
  REDEEM_ORDER
  ADJUSTMENT_CREDIT
  ADJUSTMENT_DEBIT
  EXPIRY
  REFUND_REVERSAL
}

enum ReferralStatus {
  PENDING
  QUALIFIED
  REWARDED
  CANCELLED
  REJECTED
}

enum ReferralRewardType {
  LOYALTY_POINTS
  COUPON
  MANUAL
}

enum ReferralRewardStatus {
  PENDING
  ISSUED
  CANCELLED
  FAILED
}

enum PromotionCampaignType {
  FLASH_SALE
  EID_CAMPAIGN
  BRAND_CAMPAIGN
  CATEGORY_CAMPAIGN
  FREE_SHIPPING
  BUNDLE_OFFER
  NEW_ARRIVAL
  CLEARANCE
  CUSTOM
}

enum PromotionCampaignStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  PAUSED
  ENDED
  ARCHIVED
}

enum StockStatus {
  IN_STOCK
  LOW_STOCK
  OUT_OF_STOCK
}

enum StockMovementType {
  STOCK_IN
  STOCK_OUT
  ORDER_RESERVED
  ORDER_CONFIRMED
  ORDER_CANCELLED
  MANUAL_ADJUSTMENT
  RETURN_ADJUSTMENT
}

enum WarehouseStatus {
  ACTIVE
  INACTIVE
}

enum StockTransferStatus {
  DRAFT
  REQUESTED
  IN_TRANSIT
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum SupplierStatus {
  ACTIVE
  INACTIVE
}

enum PurchaseStatus {
  DRAFT
  ORDERED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum PurchaseTimelineType {
  CREATED
  ORDERED
  RECEIVED
  CANCELLED
  NOTE
  STATUS_CHANGED
}

model User {
  id                     String                  @id @default(cuid())
  email                  String                  @unique
  passwordHash           String
  name                   String?
  isActive               Boolean                 @default(true)
  lastLoginAt            DateTime?
  roles                  RoleAssignment[]
  mediaUploads           Media[]
  apiKeys                ApiKey[]
  stockMoves             InventoryMovement[]
  purchaseCreatedBy      PurchaseOrder[]         @relation("PurchaseCreatedBy")
  purchaseUpdatedBy      PurchaseOrder[]         @relation("PurchaseUpdatedBy")
  purchaseTimelineEvents PurchaseTimelineEvent[]
  externalId             String?
  source                 String                  @default("LOCAL")
  syncStatus             SyncStatus              @default(LOCAL)
  lastSyncedAt           DateTime?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt

  @@index([externalId])
  @@index([source, syncStatus])
}

model ApiKey {
  id           String       @id @default(cuid())
  name         String       @default("BMS Integration")
  keyPrefix    String
  keyHash      String       @unique
  status       ApiKeyStatus @default(ACTIVE)
  allowedIps   String?
  webhookUrl   String?
  lastUsedAt   DateTime?
  revokedAt    DateTime?
  createdById  String?
  createdBy    User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)
  source       String       @default("LOCAL")
  syncStatus   SyncStatus   @default(LOCAL)
  lastSyncedAt DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([status])
  @@index([keyPrefix])
  @@index([createdById])
  @@index([source, syncStatus])
}

model Role {
  id          String           @id @default(cuid())
  name        RoleName         @unique
  description String?
  users       RoleAssignment[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model RoleAssignment {
  userId     String
  roleId     String
  assignedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model Category {
  id             String          @id @default(cuid())
  name           String
  slug           String          @unique
  description    String?
  thumbnailUrl   String?
  iconUrl        String?
  parentId       String?
  parent         Category?       @relation("CategoryTree", fields: [parentId], references: [id])
  children       Category[]      @relation("CategoryTree")
  products       Product[]
  images         CategoryImage[]
  sortOrder      Int             @default(0)
  isActive       Boolean         @default(true)
  isFeatured     Boolean         @default(false)
  showInMenu     Boolean         @default(true)
  seoTitle       String?
  seoDescription String?
  seoKeywords    String?
  externalId     String?
  source         String          @default("LOCAL")
  syncStatus     SyncStatus      @default(LOCAL)
  lastSyncedAt   DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([parentId])
  @@index([isFeatured])
  @@index([showInMenu])
  @@index([externalId])
  @@index([source, syncStatus])
}

model Brand {
  id             String     @id @default(cuid())
  name           String
  slug           String     @unique
  description    String?
  logoUrl        String?
  coverImageUrl  String?
  websiteUrl     String?
  products       Product[]
  isActive       Boolean    @default(true)
  isFeatured     Boolean    @default(false)
  seoTitle       String?
  seoDescription String?
  seoKeywords    String?
  externalId     String?
  source         String     @default("LOCAL")
  syncStatus     SyncStatus @default(LOCAL)
  lastSyncedAt   DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([isFeatured])
  @@index([externalId])
  @@index([source, syncStatus])
}

model Product {
  id                 String                 @id @default(cuid())
  title              String
  slug               String                 @unique
  sku                String?                @unique
  barcode            String?
  shortDescription   String?
  fullDescription    String?
  description        String?
  price              Decimal                @db.Decimal(12, 2)
  discountPrice      Decimal?               @db.Decimal(12, 2)
  costPrice          Decimal?               @db.Decimal(12, 2)
  compareAtPrice     Decimal?               @db.Decimal(12, 2)
  status             ProductStatus          @default(DRAFT)
  stockQuantity      Int                    @default(0)
  reservedStock      Int                    @default(0)
  lowStockThreshold  Int                    @default(5)
  stockStatus        StockStatus            @default(IN_STOCK)
  warehouseId        String?
  externalStockId    String?
  isFeatured         Boolean                @default(false)
  seoTitle           String?
  seoDescription     String?
  seoKeywords        String?
  categoryId         String?
  brandId            String?
  category           Category?              @relation(fields: [categoryId], references: [id])
  brand              Brand?                 @relation(fields: [brandId], references: [id])
  media              ProductMedia[]
  images             ProductImage[]
  tags               ProductTag[]
  specifications     ProductSpecification[]
  cartItems          CartItem[]
  wishlistItems      WishlistItem[]
  orderItems         OrderItem[]
  inventoryMovements InventoryMovement[]
  warehouseStocks    WarehouseStock[]
  stockTransferItems StockTransferItem[]
  inventoryAnalytics InventoryAnalytics[]
  reorderSuggestions ReorderSuggestion[]
  demandForecasts    DemandForecast[]
  deadStockSnapshots DeadStockSnapshot[]
  purchaseItems      PurchaseOrderItem[]
  externalId         String?
  source             String                 @default("LOCAL")
  syncStatus         SyncStatus             @default(LOCAL)
  lastSyncedAt       DateTime?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  @@index([categoryId])
  @@index([brandId])
  @@index([status])
  @@index([stockStatus])
  @@index([warehouseId])
  @@index([externalStockId])
  @@index([isFeatured])
  @@index([externalId])
  @@index([source, syncStatus])
}

model InventoryMovement {
  id                    String            @id @default(cuid())
  productId             String
  product               Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  type                  StockMovementType
  quantity              Int
  previousStock         Int
  newStock              Int
  previousReservedStock Int               @default(0)
  newReservedStock      Int               @default(0)
  reason                String?
  orderId               String?
  order                 Order?            @relation(fields: [orderId], references: [id], onDelete: SetNull)
  purchaseOrderId       String?
  purchaseOrder         PurchaseOrder?    @relation(fields: [purchaseOrderId], references: [id], onDelete: SetNull)
  adminUserId           String?
  adminUser             User?             @relation(fields: [adminUserId], references: [id], onDelete: SetNull)
  warehouseId           String?
  externalStockId       String?
  source                String            @default("LOCAL")
  syncStatus            SyncStatus        @default(LOCAL)
  lastSyncedAt          DateTime?
  createdAt             DateTime          @default(now())

  @@index([productId])
  @@index([type])
  @@index([orderId])
  @@index([purchaseOrderId])
  @@index([adminUserId])
  @@index([warehouseId])
  @@index([externalStockId])
  @@index([source, syncStatus])
  @@index([createdAt])
}

model Warehouse {
  id                    String              @id @default(cuid())
  code                  String              @unique
  name                  String
  status                WarehouseStatus     @default(ACTIVE)
  address               String?
  contactName           String?
  contactPhone          String?
  externalId            String?
  source                String?
  syncStatus            SyncStatus?
  lastSyncedAt          DateTime?
  locations             WarehouseLocation[]
  bins                  StockBin[]
  stocks                WarehouseStock[]
  outgoingTransfers     StockTransfer[]     @relation("StockTransferFromWarehouse")
  incomingTransfers     StockTransfer[]     @relation("StockTransferToWarehouse")
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([status])
  @@index([externalId])
}

model WarehouseLocation {
  id                String          @id @default(cuid())
  warehouseId       String
  warehouse         Warehouse       @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  code              String
  name              String
  type              String?
  zone              String?
  status            WarehouseStatus @default(ACTIVE)
  bins              StockBin[]
  stocks            WarehouseStock[]
  outgoingTransfers StockTransfer[] @relation("StockTransferFromLocation")
  incomingTransfers StockTransfer[] @relation("StockTransferToLocation")
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([warehouseId])
  @@index([code])
  @@index([status])
}

model StockBin {
  id                String          @id @default(cuid())
  warehouseId       String
  warehouse         Warehouse       @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  locationId        String?
  location          WarehouseLocation? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  code              String
  status            WarehouseStatus @default(ACTIVE)
  capacityJson      Json?
  stocks            WarehouseStock[]
  outgoingTransfers StockTransfer[] @relation("StockTransferFromBin")
  incomingTransfers StockTransfer[] @relation("StockTransferToBin")
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([warehouseId])
  @@index([locationId])
  @@index([code])
  @@index([status])
}

model WarehouseStock {
  id          String             @id @default(cuid())
  productId   String
  product     Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouseId String
  warehouse   Warehouse          @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  locationId  String?
  location    WarehouseLocation? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  binId       String?
  bin         StockBin?          @relation(fields: [binId], references: [id], onDelete: SetNull)
  onHand      Int                @default(0)
  reserved    Int                @default(0)
  available   Int                @default(0)
  updatedAt   DateTime           @updatedAt

  @@index([productId])
  @@index([warehouseId])
  @@index([locationId])
  @@index([binId])
}

model StockTransfer {
  id              String              @id @default(cuid())
  transferNumber  String              @unique
  status          StockTransferStatus @default(DRAFT)
  fromWarehouseId String?
  fromWarehouse   Warehouse?          @relation("StockTransferFromWarehouse", fields: [fromWarehouseId], references: [id], onDelete: SetNull)
  toWarehouseId   String?
  toWarehouse     Warehouse?          @relation("StockTransferToWarehouse", fields: [toWarehouseId], references: [id], onDelete: SetNull)
  fromLocationId  String?
  fromLocation    WarehouseLocation?  @relation("StockTransferFromLocation", fields: [fromLocationId], references: [id], onDelete: SetNull)
  toLocationId    String?
  toLocation      WarehouseLocation?  @relation("StockTransferToLocation", fields: [toLocationId], references: [id], onDelete: SetNull)
  fromBinId       String?
  fromBin         StockBin?           @relation("StockTransferFromBin", fields: [fromBinId], references: [id], onDelete: SetNull)
  toBinId         String?
  toBin           StockBin?           @relation("StockTransferToBin", fields: [toBinId], references: [id], onDelete: SetNull)
  requestedAt     DateTime?
  shippedAt       DateTime?
  receivedAt      DateTime?
  notes           String?
  items           StockTransferItem[]
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@index([status])
  @@index([fromWarehouseId])
  @@index([toWarehouseId])
}

model StockTransferItem {
  id               String        @id @default(cuid())
  transferId       String
  transfer         StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  productId        String
  product          Product       @relation(fields: [productId], references: [id])
  quantity         Int
  receivedQuantity Int           @default(0)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([transferId])
  @@index([productId])
}

model InventoryAnalytics {
  id                String   @id @default(cuid())
  productId         String
  product           Product  @relation(fields: [productId], references: [id])
  currentStock      Int      @default(0)
  reservedStock     Int      @default(0)
  availableStock    Int      @default(0)
  lowStockThreshold Int?
  stockStatus       String?
  salesLast7Days    Int      @default(0)
  salesLast30Days   Int      @default(0)
  salesLast90Days   Int      @default(0)
  velocityScore     Float?
  abcClass          String?
  calculatedAt      DateTime @default(now())
  createdAt         DateTime @default(now())

  @@index([productId])
  @@index([calculatedAt])
  @@index([abcClass])
}

model ReorderSuggestion {
  id                String   @id @default(cuid())
  productId         String
  product           Product  @relation(fields: [productId], references: [id])
  suggestedQuantity Int
  reason            String?
  priority          String   @default("MEDIUM")
  status            String   @default("OPEN")
  estimatedDemand   Int?
  currentStock      Int?
  leadTimeDays      Int?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([productId])
  @@index([status])
  @@index([priority])
}

model DemandForecast {
  id               String   @id @default(cuid())
  productId        String
  product          Product  @relation(fields: [productId], references: [id])
  periodStart      DateTime
  periodEnd        DateTime
  forecastQuantity Int
  actualQuantity   Int?
  confidenceScore  Float?
  method           String?
  createdAt        DateTime @default(now())

  @@index([productId])
  @@index([periodStart])
  @@index([periodEnd])
}

model DeadStockSnapshot {
  id              String   @id @default(cuid())
  productId       String
  product         Product  @relation(fields: [productId], references: [id])
  stockQuantity   Int
  daysWithoutSale Int?
  lastSoldAt      DateTime?
  estimatedValue  Decimal? @db.Decimal(12, 2)
  reason          String?
  status          String   @default("OPEN")
  calculatedAt    DateTime @default(now())
  createdAt       DateTime @default(now())

  @@index([productId])
  @@index([calculatedAt])
  @@index([status])
}

model ProductImage {
  id           String     @id @default(cuid())
  productId    String
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  mediaId      String?
  media        Media?     @relation(fields: [mediaId], references: [id], onDelete: SetNull)
  url          String
  alt          String?
  sortOrder    Int        @default(0)
  isThumbnail  Boolean    @default(false)
  externalId   String?
  source       String     @default("LOCAL")
  syncStatus   SyncStatus @default(LOCAL)
  lastSyncedAt DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([productId])
  @@index([mediaId])
  @@index([externalId])
  @@index([source, syncStatus])
}

model CategoryImage {
  id           String     @id @default(cuid())
  categoryId   String
  category     Category   @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  mediaId      String?
  media        Media?     @relation(fields: [mediaId], references: [id], onDelete: SetNull)
  url          String
  type         String     @default("THUMBNAIL")
  alt          String?
  sortOrder    Int        @default(0)
  externalId   String?
  source       String     @default("LOCAL")
  syncStatus   SyncStatus @default(LOCAL)
  lastSyncedAt DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([categoryId])
  @@index([mediaId])
  @@index([externalId])
  @@index([source, syncStatus])
}

model ProductTag {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime @default(now())

  @@unique([productId, name])
  @@index([productId])
}

model ProductSpecification {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String
  value     String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
}

model Media {
  id             String          @id @default(cuid())
  url            String
  type           MediaType       @default(IMAGE)
  alt            String?
  fileName       String?
  filename       String?
  originalName   String?
  filePath       String?
  mimeType       String?
  fileSize       Int?
  size           Int?
  width          Int?
  height         Int?
  uploadedById   String?
  uploadedBy     User?           @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  products       ProductMedia[]
  productImages  ProductImage[]
  categoryImages CategoryImage[]
  externalId     String?
  source         String          @default("LOCAL")
  syncStatus     SyncStatus      @default(LOCAL)
  lastSyncedAt   DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([uploadedById])
  @@index([mimeType])
  @@index([externalId])
  @@index([source, syncStatus])
}

model ProductMedia {
  productId String
  mediaId   String
  sortOrder Int     @default(0)
  alt       String?
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  media     Media   @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@id([productId, mediaId])
}

model SiteSetting {
  id           String     @id @default(cuid())
  key          String     @unique
  value        Json
  group        String     @default("general")
  isPublic     Boolean    @default(false)
  externalId   String?
  source       String     @default("LOCAL")
  syncStatus   SyncStatus @default(LOCAL)
  lastSyncedAt DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([group])
  @@index([externalId])
  @@index([source, syncStatus])
}

model HomeSection {
  id           String     @id @default(cuid())
  key          String     @unique
  title        String
  type         String
  content      Json
  sortOrder    Int        @default(0)
  isActive     Boolean    @default(true)
  externalId   String?
  source       String     @default("LOCAL")
  syncStatus   SyncStatus @default(LOCAL)
  lastSyncedAt DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([type])
  @@index([externalId])
  @@index([source, syncStatus])
}

model BlogCategory {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  description String?
  sortOrder   Int        @default(0)
  isActive    Boolean    @default(true)
  posts       BlogPost[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([isActive])
  @@index([sortOrder])
}

model BlogPost {
  id             String         @id @default(cuid())
  title          String
  slug           String         @unique
  excerpt        String?
  content        String
  featuredImage  String?
  categoryId     String?
  authorName     String?
  tags           String[]       @default([])
  status         BlogPostStatus @default(DRAFT)
  featured       Boolean        @default(false)
  publishedAt    DateTime?
  seoTitle       String?
  seoDescription String?
  category       BlogCategory?  @relation(fields: [categoryId], references: [id])
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([status])
  @@index([featured])
  @@index([publishedAt])
  @@index([categoryId])
}

model Customer {
  id                String             @id @default(cuid())
  email             String?            @unique
  passwordHash      String?
  firstName         String?
  lastName          String?
  phone             String?            @unique
  status            CustomerStatus     @default(ACTIVE)
  lastLoginAt       DateTime?
  addresses         CustomerAddress[]
  vehicles          CustomerVehicle[]
  carts             Cart[]
  wishlist          WishlistItem[]
  orders            Order[]
  couponRedemptions CouponRedemption[]
  notifications     CustomerNotification[]
  loyaltyAccount    LoyaltyAccount?
  loyaltyLedger     LoyaltyLedger[]
  referralCodes     ReferralCode[]
  referralsMade     ReferralRelationship[] @relation("ReferralReferrer")
  referralsReceived ReferralRelationship[] @relation("ReferralReferred")
  referralRewards   ReferralReward[]
  externalId        String?
  source            String             @default("LOCAL")
  syncStatus        SyncStatus         @default(LOCAL)
  lastSyncedAt      DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([status])
  @@index([externalId])
  @@index([source, syncStatus])
}

model CustomerSegment {
  id              String    @id @default(cuid())
  name            String
  slug            String    @unique
  description     String?
  rulesJson       Json?
  isActive        Boolean   @default(true)
  lastEvaluatedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([isActive])
  @@index([lastEvaluatedAt])
  @@index([createdAt])
}

model LoyaltyAccount {
  id               String          @id @default(cuid())
  customerId       String          @unique
  customer         Customer        @relation(fields: [customerId], references: [id])
  pointsBalance    Int             @default(0)
  lifetimeEarned   Int             @default(0)
  lifetimeRedeemed Int             @default(0)
  tier             String?
  ledger           LoyaltyLedger[]
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
}

model LoyaltyLedger {
  id           String                 @id @default(cuid())
  accountId    String
  account      LoyaltyAccount         @relation(fields: [accountId], references: [id])
  customerId   String
  customer     Customer               @relation(fields: [customerId], references: [id])
  orderId      String?
  order        Order?                 @relation(fields: [orderId], references: [id])
  type         LoyaltyTransactionType
  points       Int
  balanceAfter Int
  description  String?
  metadata     Json?
  expiresAt    DateTime?
  createdAt    DateTime               @default(now())

  @@index([accountId])
  @@index([customerId])
  @@index([orderId])
  @@index([type])
  @@index([createdAt])
  @@index([expiresAt])
}

model ReferralCode {
  id            String                 @id @default(cuid())
  customerId    String
  customer      Customer               @relation(fields: [customerId], references: [id])
  code          String                 @unique
  isActive      Boolean                @default(true)
  usageLimit    Int?
  usedCount     Int                    @default(0)
  relationships ReferralRelationship[]
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  @@index([customerId])
  @@index([isActive])
}

model ReferralRelationship {
  id                 String           @id @default(cuid())
  referralCodeId     String
  referralCode       ReferralCode     @relation(fields: [referralCodeId], references: [id])
  referrerCustomerId String
  referrerCustomer   Customer         @relation("ReferralReferrer", fields: [referrerCustomerId], references: [id])
  referredCustomerId String?
  referredCustomer   Customer?        @relation("ReferralReferred", fields: [referredCustomerId], references: [id])
  referredEmail      String?
  referredPhone      String?
  qualifyingOrderId  String?
  qualifyingOrder    Order?           @relation(fields: [qualifyingOrderId], references: [id])
  status             ReferralStatus   @default(PENDING)
  rewards            ReferralReward[]
  qualifiedAt        DateTime?
  rewardedAt         DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([referralCodeId])
  @@index([referrerCustomerId])
  @@index([referredCustomerId])
  @@index([qualifyingOrderId])
  @@index([status])
}

model ReferralReward {
  id             String               @id @default(cuid())
  relationshipId String
  relationship   ReferralRelationship @relation(fields: [relationshipId], references: [id])
  customerId     String
  customer       Customer             @relation(fields: [customerId], references: [id])
  orderId        String?
  order          Order?               @relation(fields: [orderId], references: [id])
  type           ReferralRewardType
  status         ReferralRewardStatus @default(PENDING)
  points         Int?
  couponId       String?
  coupon         Coupon?              @relation(fields: [couponId], references: [id])
  value          String?
  description    String?
  issuedAt       DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@index([relationshipId])
  @@index([customerId])
  @@index([orderId])
  @@index([couponId])
  @@index([status])
}

model CustomerOtp {
  id          String     @id @default(cuid())
  identifier  String
  channel     OtpChannel
  otpHash     String
  expiresAt   DateTime
  attempts    Int        @default(0)
  maxAttempts Int        @default(5)
  usedAt      DateTime?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([identifier, channel])
  @@index([expiresAt])
  @@index([usedAt])
  @@index([createdAt])
}

model CustomerPasswordAttempt {
  id            String     @id @default(cuid())
  identifier    String
  channel       OtpChannel
  attempts      Int        @default(0)
  lockedUntil   DateTime?
  lastAttemptAt DateTime?
  ipAddress     String?
  userAgent     String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@unique([identifier, channel])
  @@index([lockedUntil])
  @@index([lastAttemptAt])
  @@index([channel])
}

model OtpProvider {
  id                  String          @id @default(cuid())
  name                String
  channel             OtpChannel
  providerType        OtpProviderType
  isActive            Boolean         @default(true)
  isDefault           Boolean         @default(false)
  baseUrl             String?
  method              String?
  fromEmail           String?
  fromName            String?
  senderId            String?
  configJson          Json?
  secretJsonEncrypted String?
  timeoutMs           Int             @default(10000)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  @@index([channel])
  @@index([channel, isActive])
  @@index([channel, isDefault])
  @@index([providerType])
}

model OtpTemplate {
  id        String             @id @default(cuid())
  channel   OtpChannel
  purpose   OtpTemplatePurpose @default(OTP_LOGIN)
  subject   String?
  message   String
  isActive  Boolean            @default(true)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@index([channel])
  @@index([channel, purpose])
  @@index([isActive])
}

model EmailTemplate {
  id            String                @id @default(cuid())
  name          String
  slug          String                @unique
  category      EmailTemplateCategory @default(TRANSACTIONAL)
  subject       String
  htmlBody      String
  textBody      String?
  variablesJson Json?
  isActive      Boolean               @default(true)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  deliveryLogs  EmailDeliveryLog[]

  @@index([category])
  @@index([isActive])
}

model EmailDeliveryLog {
  id                String              @id @default(cuid())
  templateId        String?
  template          EmailTemplate?      @relation(fields: [templateId], references: [id])
  recipientEmail    String
  subject           String
  status            EmailDeliveryStatus @default(PENDING)
  provider          String?
  providerMessageId String?
  errorMessage      String?
  sentAt            DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([status])
  @@index([recipientEmail])
  @@index([sentAt])
}

model NotificationTemplate {
  id            String              @id @default(cuid())
  name          String
  slug          String              @unique
  channel       NotificationChannel
  subject       String?
  body          String
  variablesJson Json?
  isActive      Boolean             @default(true)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  logs          NotificationLog[]

  @@index([channel])
  @@index([isActive])
}

model NotificationLog {
  id                String                @id @default(cuid())
  recipient         String
  channel           NotificationChannel
  status            NotificationStatus    @default(PENDING)
  templateId        String?
  template          NotificationTemplate? @relation(fields: [templateId], references: [id])
  provider          String?
  providerMessageId String?
  errorMessage      String?
  sentAt            DateTime?
  readAt            DateTime?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  @@index([channel])
  @@index([status])
  @@index([recipient])
  @@index([sentAt])
}

model CustomerNotification {
  id         String    @id @default(cuid())
  customerId String
  customer   Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  title      String
  body       String
  actionUrl  String?
  isRead     Boolean   @default(false)
  readAt     DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([customerId])
  @@index([isRead])
  @@index([createdAt])
}

model CustomerAddress {
  id           String      @id @default(cuid())
  customerId   String
  customer     Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  type         AddressType @default(SHIPPING)
  firstName    String?
  lastName     String?
  phone        String?
  addressLine1 String
  addressLine2 String?
  city         String?
  zone         String?
  postalCode   String?
  country      String      @default("Bangladesh")
  isDefault    Boolean     @default(false)
  externalId   String?
  source       String      @default("LOCAL")
  syncStatus   SyncStatus  @default(LOCAL)
  lastSyncedAt DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([customerId])
  @@index([externalId])
  @@index([source, syncStatus])
}

model CustomerVehicle {
  id           String     @id @default(cuid())
  customerId   String
  customer     Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  make         String
  model        String
  year         Int?
  chassisCode  String?
  engineType   String?
  isDefault    Boolean    @default(false)
  externalId   String?
  source       String     @default("LOCAL")
  syncStatus   SyncStatus @default(LOCAL)
  lastSyncedAt DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([customerId])
  @@index([make, model])
  @@index([externalId])
  @@index([source, syncStatus])
}

model Cart {
  id           String     @id @default(cuid())
  customerId   String?
  customer     Customer?  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  guestId      String?
  status       CartStatus @default(ACTIVE)
  currency     String     @default("BDT")
  subtotal     Decimal    @default(0) @db.Decimal(12, 2)
  items        CartItem[]
  order        Order?
  externalId   String?
  source       String     @default("LOCAL")
  syncStatus   SyncStatus @default(LOCAL)
  lastSyncedAt DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([customerId, status])
  @@index([guestId, status])
  @@index([externalId])
  @@index([source, syncStatus])
}

model CartItem {
  id           String     @id @default(cuid())
  cartId       String
  cart         Cart       @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId    String?
  product      Product?   @relation(fields: [productId], references: [id], onDelete: SetNull)
  productTitle String
  sku          String?
  imageUrl     String?
  unitPrice    Decimal    @db.Decimal(12, 2)
  quantity     Int        @default(1)
  externalId   String?
  source       String     @default("LOCAL")
  syncStatus   SyncStatus @default(LOCAL)
  lastSyncedAt DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([cartId])
  @@index([productId])
  @@index([externalId])
  @@index([source, syncStatus])
}

model WishlistItem {
  id           String     @id @default(cuid())
  customerId   String?
  customer     Customer?  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  guestId      String?
  productId    String?
  product      Product?   @relation(fields: [productId], references: [id], onDelete: SetNull)
  productTitle String
  sku          String?
  imageUrl     String?
  unitPrice    Decimal?   @db.Decimal(12, 2)
  productUrl   String?
  externalId   String?
  source       String     @default("LOCAL")
  syncStatus   SyncStatus @default(LOCAL)
  lastSyncedAt DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([customerId])
  @@index([guestId])
  @@index([productId])
  @@index([externalId])
  @@index([source, syncStatus])
}

model Coupon {
  id            String             @id @default(cuid())
  code          String             @unique
  description   String?
  discountType  String             @default("FIXED")
  discountValue Decimal            @db.Decimal(12, 2)
  minOrderValue Decimal?           @db.Decimal(12, 2)
  maxDiscount   Decimal?           @db.Decimal(12, 2)
  startsAt      DateTime?
  endsAt        DateTime?
  usageLimit    Int?
  usedCount     Int                @default(0)
  isActive      Boolean            @default(true)
  orders        Order[]
  redemptions   CouponRedemption[]
  referralRewards ReferralReward[]
  externalId    String?
  source        String             @default("LOCAL")
  syncStatus    SyncStatus         @default(LOCAL)
  lastSyncedAt  DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([isActive])
  @@index([externalId])
  @@index([source, syncStatus])
}

model PromotionCampaign {
  id                 String                  @id @default(cuid())
  name               String
  slug               String                  @unique
  type               PromotionCampaignType   @default(CUSTOM)
  status             PromotionCampaignStatus @default(DRAFT)
  priority           Int                     @default(0)
  startsAt           DateTime?
  endsAt             DateTime?
  rulesJson          Json?
  actionsJson        Json?
  bannerImage        String?
  landingPageEnabled Boolean                 @default(false)
  seoTitle           String?
  seoDescription     String?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  @@index([status])
  @@index([type])
  @@index([startsAt])
  @@index([endsAt])
  @@index([priority])
}

model Order {
  id                 String              @id @default(cuid())
  orderNumber        String              @unique
  customerId         String?
  customer           Customer?           @relation(fields: [customerId], references: [id], onDelete: SetNull)
  cartId             String?             @unique
  cart               Cart?               @relation(fields: [cartId], references: [id], onDelete: SetNull)
  couponId           String?
  coupon             Coupon?             @relation(fields: [couponId], references: [id], onDelete: SetNull)
  couponRedemption   CouponRedemption?
  items              OrderItem[]
  payments           Payment[]
  inventoryMovements InventoryMovement[]
  loyaltyLedger      LoyaltyLedger[]
  referralRelationships ReferralRelationship[]
  referralRewards    ReferralReward[]
  status             OrderStatus         @default(PENDING)
  paymentStatus      PaymentStatus       @default(UNPAID)
  paymentMethod      PaymentMethod       @default(CASH_ON_DELIVERY)
  paymentGateway     String?
  transactionId      String?
  paidAt             DateTime?
  gatewayResponse    Json?
  paymentMeta        Json?
  currency           String              @default("BDT")
  subtotal           Decimal             @db.Decimal(12, 2)
  discountTotal      Decimal             @default(0) @db.Decimal(12, 2)
  deliveryCharge     Decimal             @default(0) @db.Decimal(12, 2)
  taxTotal           Decimal             @default(0) @db.Decimal(12, 2)
  total              Decimal             @db.Decimal(12, 2)
  customerEmail      String?
  customerName       String?
  customerPhone      String?
  notes              String?
  billingAddress     Json?
  shippingAddress    Json?
  timeline           Json?
  invoiceNumber      String?             @unique
  invoiceGeneratedAt DateTime?
  printedAt          DateTime?
  externalOrderId    String?
  externalId         String?
  source             String              @default("LOCAL")
  syncStatus         SyncStatus          @default(LOCAL)
  lastSyncedAt       DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([customerId])
  @@index([status])
  @@index([paymentStatus])
  @@index([paymentGateway])
  @@index([transactionId])
  @@index([invoiceNumber])
  @@index([externalOrderId])
  @@index([externalId])
  @@index([source, syncStatus])
}

model CouponRedemption {
  id                 String                 @id @default(cuid())
  couponId           String
  coupon             Coupon                 @relation(fields: [couponId], references: [id])
  orderId            String?                @unique
  order              Order?                 @relation(fields: [orderId], references: [id])
  customerId         String?
  customer           Customer?              @relation(fields: [customerId], references: [id])
  email              String?
  phone              String?
  code               String
  discountType       String
  discountValue      Decimal                @db.Decimal(12, 2)
  discountAmount     Decimal                @db.Decimal(12, 2)
  subtotal           Decimal                @db.Decimal(12, 2)
  totalAfterDiscount Decimal                @db.Decimal(12, 2)
  status             CouponRedemptionStatus @default(APPLIED)
  redeemedAt         DateTime               @default(now())
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  @@index([couponId])
  @@index([customerId])
  @@index([code])
  @@index([status])
  @@index([redeemedAt])
}

model OrderItem {
  id           String   @id @default(cuid())
  orderId      String
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    String?
  product      Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productTitle String
  sku          String?
  imageUrl     String?
  unitPrice    Decimal  @db.Decimal(12, 2)
  quantity     Int
  total        Decimal  @db.Decimal(12, 2)
  createdAt    DateTime @default(now())

  @@index([orderId])
  @@index([productId])
}

model Payment {
  id              String        @id @default(cuid())
  orderId         String
  order           Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  method          PaymentMethod
  status          PaymentStatus @default(PENDING)
  amount          Decimal       @db.Decimal(12, 2)
  transactionId   String?
  gateway         String?
  gatewayPayload  Json?
  gatewayResponse Json?
  paymentMeta     Json?
  paidAt          DateTime?
  externalId      String?
  source          String        @default("LOCAL")
  syncStatus      SyncStatus    @default(LOCAL)
  lastSyncedAt    DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([orderId])
  @@index([method, status])
  @@index([gateway])
  @@index([transactionId])
  @@index([externalId])
  @@index([source, syncStatus])
}

model Supplier {
  id            String          @id @default(cuid())
  name          String
  companyName   String?
  contactPerson String?
  phone         String?
  email         String?
  address       String?
  notes         String?
  status        SupplierStatus  @default(ACTIVE)
  purchases     PurchaseOrder[]
  externalId    String?
  source        String          @default("LOCAL")
  syncStatus    SyncStatus      @default(LOCAL)
  lastSyncedAt  DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([status])
  @@index([email])
  @@index([phone])
  @@index([externalId])
  @@index([source, syncStatus])
}

model PurchaseOrder {
  id                 String                  @id @default(cuid())
  purchaseNumber     String                  @unique
  supplierId         String?
  supplier           Supplier?               @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  status             PurchaseStatus          @default(DRAFT)
  subtotal           Decimal                 @default(0) @db.Decimal(12, 2)
  total              Decimal                 @default(0) @db.Decimal(12, 2)
  notes              String?
  warehouseId        String?
  externalPurchaseId String?
  externalId         String?
  source             String                  @default("LOCAL")
  syncStatus         SyncStatus              @default(LOCAL)
  lastSyncedAt       DateTime?
  orderedAt          DateTime?
  receivedAt         DateTime?
  cancelledAt        DateTime?
  createdById        String?
  createdBy          User?                   @relation("PurchaseCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedById        String?
  updatedBy          User?                   @relation("PurchaseUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
  items              PurchaseOrderItem[]
  timeline           PurchaseTimelineEvent[]
  inventoryMovements InventoryMovement[]
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  @@index([supplierId])
  @@index([status])
  @@index([warehouseId])
  @@index([externalPurchaseId])
  @@index([externalId])
  @@index([source, syncStatus])
  @@index([createdAt])
}

model PurchaseOrderItem {
  id               String        @id @default(cuid())
  purchaseOrderId  String
  purchaseOrder    PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  productId        String?
  product          Product?      @relation(fields: [productId], references: [id], onDelete: SetNull)
  productTitle     String
  sku              String?
  quantity         Int
  receivedQuantity Int           @default(0)
  costPrice        Decimal       @db.Decimal(12, 2)
  total            Decimal       @db.Decimal(12, 2)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([purchaseOrderId])
  @@index([productId])
}

model PurchaseTimelineEvent {
  id              String               @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder        @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  type            PurchaseTimelineType
  title           String
  message         String?
  fromStatus      PurchaseStatus?
  toStatus        PurchaseStatus?
  adminUserId     String?
  adminUser       User?                @relation(fields: [adminUserId], references: [id], onDelete: SetNull)
  createdAt       DateTime             @default(now())

  @@index([purchaseOrderId])
  @@index([type])
  @@index([adminUserId])
  @@index([createdAt])
}

model IntegrationEventLog {
  id             String                 @id @default(cuid())
  direction      String
  sourceSystem   String
  targetSystem   String?
  eventType      String
  entityType     String
  entityId       String?
  externalId     String?
  apiKeyId       String?
  requestId      String?
  idempotencyKey String?
  status         IntegrationEventStatus @default(RECEIVED)
  payloadJson    Json?
  responseJson   Json?
  errorMessage   String?
  attempts       Int                    @default(0)
  processedAt    DateTime?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  @@index([direction])
  @@index([sourceSystem])
  @@index([eventType])
  @@index([entityType])
  @@index([entityId])
  @@index([externalId])
  @@index([status])
  @@index([idempotencyKey])
  @@index([createdAt])
}

model IntegrationIdempotencyKey {
  id          String                 @id @default(cuid())
  key         String                 @unique
  sourceSystem String
  endpoint    String
  requestHash String?
  responseJson Json?
  status      IntegrationEventStatus @default(RECEIVED)
  expiresAt   DateTime?
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  @@index([sourceSystem])
  @@index([endpoint])
  @@index([status])
  @@index([expiresAt])
}

model IntegrationConflict {
  id                String                    @id @default(cuid())
  entityType        String
  entityId          String?
  externalId        String?
  conflictType      String
  fieldPath         String?
  localValueJson    Json?
  incomingValueJson Json?
  status            IntegrationConflictStatus @default(OPEN)
  resolutionJson    Json?
  resolvedById      String?
  resolvedAt        DateTime?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt

  @@index([entityType])
  @@index([entityId])
  @@index([externalId])
  @@index([conflictType])
  @@index([status])
  @@index([createdAt])
}
